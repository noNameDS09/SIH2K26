# KalaSetu — copy to .env and fill the blanks:
#   cp .env.example .env
# Root `.env` is FastAPI.
# Next.js public config: copy NEXT_PUBLIC_* into apps/web/.env.local (gitignored).
# Never commit .env. Never put Sarvam/Gemini keys in NEXT_PUBLIC_*.

# ---------------------------------------------------------------------------
# Local process
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501,http://127.0.0.1:8501
PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Used when signing listings + QR later. Generate with:
#   openssl rand -hex 32
LISTING_HMAC_SECRET=

# Protects POST /v1/trends/recompute until Admin auth is wired.
#   openssl rand -hex 24
ADMIN_API_TOKEN=

# ---------------------------------------------------------------------------
# OTP  (default is mock 123456 — labelled on screen)
# ---------------------------------------------------------------------------
OTP_PROVIDER=mock
OTP_MOCK_CODE=123456
# Only if you switch OTP_PROVIDER=2factor later:
TWOFACTOR_API_KEY=

# ---------------------------------------------------------------------------
# Sarvam  (web speech always goes through FastAPI; never NEXT_PUBLIC_)
# Get: https://dashboard.sarvam.ai/key-management
# One key covers Saaras STT, Bulbul TTS, Translate. Copy it once — shown once.
# ---------------------------------------------------------------------------
SARVAM_API_KEY=
SARVAM_API_BASE_URL=https://api.sarvam.ai

# ---------------------------------------------------------------------------
# Gemini  (Live cataloger + advisor phrasing). Web never gets this key.
# Get: https://aistudio.google.com/apikey
# Same key is used for Live WebSocket and JSON text.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Cheap tester / JSON copy. Live WebSocket is a later path.
GEMINI_MODEL=gemini-2.5-flash-lite
# Cheapest Live API native-audio model (FastAPI holds the socket).
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_SAMPLE_RATE=16000

# ---------------------------------------------------------------------------
# Firebase
# Firestore MUST stay asia-south1 / Mumbai. If that cannot be created, STOP.
# Storage Spark/no-cost default is US-EAST1 (Mumbai not offered). Locked exception.
#
# From Project settings → General → Your apps → Web app:
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIRESTORE_LOCATION=asia-south1
FIRESTORE_DATABASE=(default)
FIREBASE_STORAGE_LOCATION=us-east1
FIREBASE_STORAGE_BUCKET=kalasetu-903c2.firebasestorage.app

# Web SDK config (public by design — still do not commit a filled .env)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=kalasetu-903c2.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin SDK (server only). Download JSON from
# Project settings → Service accounts → Generate new private key
# Save as secrets/firebase-adminsdk.json (gitignored)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-adminsdk.json
